{
    "name": "kranti/digital-showroom-backend",
    "description": "Production-ready PHP 8.2+ & MySQL 8+ REST API backend for Kranti Furnitures & Electronics Digital Showroom",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
